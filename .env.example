# Configuración de Base de Datos
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tienda_eureka?schema=public"

# Configuración de la Aplicación
NODE_ENV=development
PORT=3000

# Configuración de CORS (URLs del frontend)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Configuración de JWT (Seguridad)
JWT_SECRET="tu-secreto-super-seguro-de-al-menos-32-caracteres"
JWT_EXPIRATION="24h"

# Configuración de Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Configuración de Izipay (Sandbox)
IZIPAY_BASE_URL="https://sandbox.izipay.pe"
IZIPAY_API_KEY="tu-api-key-de-sandbox"
IZIPAY_SECRET="tu-secreto-de-sandbox"